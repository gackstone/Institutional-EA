{
  "name": "institutional-ea-companion",
  "version": "1.3.0",
  "description": "Institutional EA Companion Desktop Application",
  "author": "Institutional EA",
  "homepage": "https://github.com/gackstone/Institutional-EA",
  "repository": {
    "type": "git",
    "url": "https://github.com/gackstone/Institutional-EA.git"
  },
  "bugs": {
    "url": "https://github.com/gackstone/Institutional-EA/issues"
  },
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "node --experimental-strip-types --test src/utils/__tests__/tradeChartMath.test.ts src/utils/__tests__/chartTvLightFixture.test.ts src/utils/__tests__/topBarControlState.test.ts src/utils/__tests__/chartDrawingsParity.test.ts src/utils/__tests__/startupSafety.test.ts src/utils/__tests__/luxalgoSmc.test.ts",
    "test:smoke": "node scripts/smoke_test.cjs",
    "preview": "vite preview",
    "electron": "electron electron/main.cjs",
    "electron:dev": "concurrently \"vite\" \"wait-on tcp:5173 && electron electron/main.cjs --dev\"",
    "sidecars": "python packaging/build_sidecars.py",
    "dist:win": "npm run build && electron-builder --win nsis:x64 && node -e \"const fs=require('fs'),p=require('./package.json');fs.copyFileSync('release/Institutional-EA-Setup-'+p.version+'.exe','release/setup.exe')\"",
    "package:win": "python packaging/build_sidecars.py && npm run dist:win",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "lightweight-charts": "^5.3.0",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/cli": "^2.2.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.institutionalea.companion",
    "productName": "Institutional EA",
    "copyright": "Copyright © 2026 Institutional EA",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../mql5",
        "to": "mql5",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../config",
        "to": "config",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "Institutional EA",
      "uninstallDisplayName": "Institutional EA",
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "installerHeader": "resources/installerHeader.bmp",
      "installerSidebar": "resources/installerSidebar.bmp",
      "uninstallerSidebar": "resources/installerSidebar.bmp",
      "include": "resources/installer.nsh",
      "artifactName": "Institutional-EA-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    }
  }
}
