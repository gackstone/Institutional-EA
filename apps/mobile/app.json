{
  "expo": {
    "name": "Institutional EA",
    "slug": "institutional-ea-mobile",
    "version": "1.3.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.institutionalea.monitor",
      "buildNumber": "1.3.4",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use FaceID to unlock your read-only monitoring dashboard."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.institutionalea.monitor",
      "versionCode": 10304,
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "INTERNET"
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 34,
            "targetSdkVersion": 34
          },
          "ios": {
            "deploymentTarget": "15.0"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "775ac6ca-f140-4ada-bfc9-201a817891cc"
      }
    }
  }
}
