{
  "name": "institutional-ea-monorepo",
  "version": "1.3.5",
  "private": true,
  "description": "Institutional EA Monorepo â€” Desktop Companion, Mobile App, and Shared Packages",
  "workspaces": [
    "companion",
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "npm test --workspace=companion",
    "test:desktop": "npm test --workspace=companion",
    "test:packages": "npm test --workspace=@institutional-ea/data-contract --workspace=@institutional-ea/chart-core --workspace=@institutional-ea/cloud-contract",
    "test:mobile": "npm test --workspace=@institutional-ea/mobile",
    "test:all": "npm run test:desktop && npm run test:packages && npm run test:mobile",
    "build:desktop": "npm run build --workspace=companion",
    "build:web": "npm run build --workspace=@institutional-ea/web",
    "verify:branding": "python scripts/verify-brand-assets.py",
    "verify:branding:builds": "python scripts/verify-brand-assets.py --check-builds"
  },
  "devDependencies": {
    "@types/node": "^22.13.0"
  }
}
