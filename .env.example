# ==============================================================================
# Institutional EA Environment Configuration Template
# Copy this file to .env and populate with your live credentials/settings.
# DO NOT commit the .env file containing live secrets to version control.
# ==============================================================================

# --- Telegram Bot Configuration ---
# Create your bot via @BotFather on Telegram to obtain the token
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user ID or authorized chat ID
TELEGRAM_CHAT_ID=
# Enable or disable Telegram dispatching (true / false)
TELEGRAM_ENABLED=true
# Optional SOCKS5 or HTTP proxy URL for Telegram WebRequests (e.g., socks5h://127.0.0.1:1080)
TELEGRAM_PROXY=

# --- MetaTrader 5 Bridge Socket IPC ---
# Local host and port for EA <-> Python zero-dependency TCP socket
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=5555

# --- Execution & Account Risk Profile ---
# Operational mode: DEMO, LIVE, or PROP
EXECUTION_MODE=DEMO

# --- Institutional EA Cloud Dashboard Integration ---
# Default external cloud endpoint
INSTITUTIONAL_EA_API_URL=https://arcadefx.live/api/v1

# ==============================================================================
# Supabase Cloud Backend (Authentication, Subscriptions, Payments, Devices)
# ==============================================================================
# Public Supabase project URL (safe for browser & desktop client config)
SUPABASE_URL=https://your-project-ref.supabase.co
# Public Supabase publishable / anonymous key (RLS-protected; safe for client config)
SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Public Website (Vite) equivalents — set in apps/web/.env.local or Vercel Environment Variables
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
VITE_PUBLIC_SITE_URL=https://your-institutional-ea-domain.com

# Windows Companion Desktop Auth Portal URL (used for system-browser loopback sign-in)
INSTITUTIONAL_EA_WEB_URL=https://your-institutional-ea-domain.com

# ------------------------------------------------------------------------------
# SERVER-SIDE SECRETS ONLY — NEVER expose in browser, Vite, or Electron binaries!
# Set these ONLY in local backend .env, Supabase Edge Function secrets, or server env.
# URL-encode special characters in database passwords (e.g., ! -> %21).
# ------------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-server-side-only-secret-or-service-role-key
SUPABASE_JWT_SECRET=your-server-side-only-jwt-secret
DATABASE_URL=postgresql://postgres.your-project-ref:URL_ENCODED_PASSWORD@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:URL_ENCODED_PASSWORD@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?sslmode=require
